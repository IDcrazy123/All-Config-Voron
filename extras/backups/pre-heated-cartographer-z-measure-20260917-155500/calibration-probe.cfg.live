# CALIBRATION-PROBE.CFG - Cartographer bed probing and tool-offset workflow
#
# Cartographer is fixed to the shuttle and remains the production Z-home/mesh
# probe. kTAMV provides supervised camera-based XY comparison and alignment.
# PF2 Axiscope and tools_calibrate remain disabled.

#####################################################################
# Cartographer V3 - measured production geometry
#####################################################################

[cartographer]
mcu: cartographer
x_offset: 0                # Coil X offset relative to the nozzle.
y_offset: 35               # Coil Y offset relative to the nozzle.
verbose: no

#####################################################################
# Bed mesh - coordinates are probe coordinates, not nozzle coordinates
#####################################################################

[bed_mesh]
zero_reference_position: 174, 168
speed: 600
horizontal_move_z: 3
mesh_min: 20, 45
mesh_max: 320, 325
probe_count: 55, 55
adaptive_margin: 10
mesh_pps: 0,0

#####################################################################
# Cartographer onboard ADXL345 and saved axis-twist model
#####################################################################

[adxl345]
cs_pin: cartographer:PA3
spi_bus: spi1

[axis_twist_compensation]
# Klipper stores measured z_compensations in printer.cfg SAVE_CONFIG.

#####################################################################
# Calibration backend status and read-only offset report
#####################################################################

[gcode_macro CALIBRATION_STATUS]
description: Report the active tool-offset calibration backend
gcode:
  RESPOND MSG="Calibration backend: supervised kTAMV camera XY alignment; Axiscope Z switch (X68 Y-8 Z2)"
  RESPOND MSG="kTAMV is XY-only, does not save offsets, and loses calibration/origin after Klipper restart"
  {% if printer.ktamv is defined %}
    RESPOND MSG="kTAMV calibrated={printer.ktamv.is_calibrated}; mm_per_pixel={printer.ktamv.mm_per_pixels}; origin={printer.ktamv.camera_center_coordinates}"
  {% else %}
    RESPOND TYPE=error MSG="kTAMV status object is unavailable"
  {% endif %}

[gcode_macro CHECK_OFFSETS]
description: Report XYZ offsets for every configured tool
gcode:
  _CHECK_OFFSETS

[gcode_macro _CHECK_OFFSETS]
description: Report XYZ offsets for every configured tool
gcode:
  RESPOND MSG="=== FIVE-TOOL XYZ OFFSETS ==="
  {% for tname in printer.toolchanger.tool_names %}
    {% set tool = printer[tname] %}
    RESPOND MSG="{tname}: X={tool.gcode_x_offset|float|round(4)} Y={tool.gcode_y_offset|float|round(4)} Z={tool.gcode_z_offset|float|round(4)}"
  {% endfor %}

# KTC readonly files expose the legacy SexBolt commands even though
# [tools_calibrate] is disabled. Override them with explicit errors so a stale
# dashboard button cannot access the missing probe_multi_axis owner.
[gcode_macro CALIBRATE_MOVE_OVER_PROBE]
description: Disabled legacy tools_calibrate command
gcode:
  {action_raise_error("tools_calibrate is disabled. kTAMV is active for supervised XY comparison; Axiscope is active for Z switch.")}

[gcode_macro CALIBRATE_ALL_OFFSETS]
description: Disabled KTC tools_calibrate SexBolt XYZ command
gcode:
  {action_raise_error("CALIBRATE_ALL_OFFSETS is the disabled KTC SexBolt XYZ workflow. Use KTAMV_AUTO_CALIBRATE_ALL_TOOLS for camera XY, or CALIBRATE_ALL_Z_OFFSETS for Axiscope Z.")}

[gcode_macro CALIBRATE_NOZZLE_PROBE_OFFSET]
description: Disabled legacy tool-probe command
gcode:
  {action_raise_error("No tool_probe_endstop is configured; Cartographer is fixed to the shuttle.")}

[gcode_macro _SEXBALL_CALIBRATION_GUIDE]
description: Report the current replacement for the retired SexBolt workflow
gcode:
  RESPOND MSG="Current backend: supervised kTAMV camera XY alignment"
  RESPOND MSG="Run CALIBRATION_STATUS and CHECK_OFFSETS for current state"

#####################################################################
# Axiscope - Microswitch Z offset calibration (PF2 on M8P V2)
#####################################################################

[axiscope]
pin: ^PF2
zswitch_x_pos: 68.0       # T0 nozzle centered over the physical switch.
zswitch_y_pos: -8.0       # Measured contact/reference Y.
zswitch_z_pos: 2.0        # Measured contact/reference Z.
lift_z: 2.0
move_speed: 100
z_move_speed: 5
samples: 10
# Do not set config_file_path: tool sections live in separate T0-T4 files.
# Axiscope therefore reports measured deltas without rewriting split configs.
start_gcode:
  M117 Axiscope Z: Gia nhiet 150C toan bo tool
  {% for tool in printer.toolchanger.tool_numbers %}
    M104 T{tool} S150
  {% endfor %}
  # Cho T0 (tool goc quy chieu) dat du 150C truoc khi bat dau do
  M109 T0 S150
before_pickup_gcode:
  # Nang Z an toan truoc khi di chuyen ve dock doi tool
  {% if printer.toolhead.position[2]|float < 15.0 %}
    G90
    G1 Z15 F1800
  {% endif %}
after_pickup_gcode:
  # Dam bao tool vua gap dat du 150C truoc khi tiep can cong tac
  M109 S150
finish_gcode:
  {% for tool in printer.toolchanger.tool_numbers %}
    M104 T{tool} S0
  {% endfor %}
  T0
  M117 Axiscope calibration complete

#####################################################################
# Cartographer Multi-Tool Z Measurement Sequence
#####################################################################

[gcode_macro MEASURE_ALL_Z_CARTOGRAPHER]
description: Do Z cham ban bang Cartographer Touch cho toan bo 5 Tool (T0->T4) de tinh Z offset
gcode:
  {% set test_x = params.X|default(175.0)|float %}
  {% set test_y = params.Y|default(175.0)|float %}
  {% set safe_z = params.SAFE_Z|default(10.0)|float %}
  {% set samples = params.SAMPLES|default(3)|int %}

  {% if "xyz" not in printer.toolhead.homed_axes %}
    RESPOND MSG="Chua home he truc, tien hanh G28..."
    G28
  {% endif %}

  G90
  RESPOND MSG="=== BAT DAU CHUOI DO Z T0 -> T4 VOI CARTOGRAPHER TOUCH ==="
  RESPOND MSG="Toa do do tren ban: X={test_x} Y={test_y} (Nozzle contact point)"

  {% for t in range(5) %}
    RESPOND MSG="--------------------------------------------"
    RESPOND MSG=">>> [TOOL T{t}] DANG PICKUP VA DI CHUYEN DEN DIEM DO <<<"
    T{t}
    G90
    G0 Z{safe_z} F3000
    G0 X{test_x} Y{test_y} F6000
    M400
    {% set cur_tool = printer['tool T' ~ t] %}
    {% set cur_z_off = cur_tool.gcode_z_offset|default(0.0)|float %}
    RESPOND MSG=">>> [TOOL T{t}] CURRENT_GCODE_Z_OFFSET = {cur_z_off} <<<"
    RESPOND MSG=">>> [TOOL T{t}] DANG THUC HIEN CARTOGRAPHER_TOUCH_ACCURACY (SAMPLES={samples}) <<<"
    CARTOGRAPHER_TOUCH_ACCURACY SAMPLES={samples}
    M400
    G90
    G0 Z{safe_z} F3000
    M400
  {% endfor %}

  RESPOND MSG="--------------------------------------------"
  RESPOND MSG=">>> HOAN TAT CHUOI DO Z CHO 5 TOOL! Tra ve T0... <<<"
  T0
  G90
  G0 Z{safe_z} F3000
  RESPOND MSG="=== COPY TOAN BO NHAT KY TREN CONSOLE GUI CHO AI DE TINH TOAN Z-OFFSET ==="

