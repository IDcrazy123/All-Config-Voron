# =====================================================================
# kTAMV - Klipper Tool Alignment with Machine Vision (Voron 5-Tool)
# Upstream: https://github.com/TypQxQ/kTAMV
# Reviewed commit: 72421f2d54da0de8701c4f84449c6e6b7d060301
#
# =====================================================================
# HUONG DAN SU DUNG kTAMV DO SAI LECH XY (VORON 5-TOOL):
# =====================================================================
#
# CACH 1: QUY TRINH 1-CHAM TOAN TRINH (KHUYEN DUNG)
# ---------------------------------------------------------------------
#   Buoc 1: Chay G28 (Home toan bo cac truc).
#   Buoc 2: Chon T0 va dua dau phun T0 den tren tam camera (Z=40):
#             T0
#             G1 X170.9 Y4.4 Z40 F6000
#   Buoc 3: Chay 1 lenh duy nhat tren console:
#             KTAMV_FULL_CALIBRATION_CYCLE
#           -> May se tu dong:
#              + Dong bo camera URL sang server (chong loi 502).
#              + Tat LED T0 tranh choi sang.
#              + Calib ti le mm/pixel & can tam T0 de set Goc Origin.
#              + Lan luot doi sang T1, T2, T3, T4.
#              + Moi tool tu do 3 lan (SAMPLES=3), tinh gia tri trung binh
#                va nap thang vao gcode_x_offset / gcode_y_offset.
#              + Tro ve T0 va dung tai do cao an toan Z=40.
#   Buoc 4: Kiem tra bang offset va luu vinh vien:
#             CHECK_OFFSETS
#             SAVE_CONFIG
#
# CACH 2: QUY TRINH 2 GIAI DOAN (KIEM SOAT TUNG BUOC)
# ---------------------------------------------------------------------
#   Giai doan A (Xac lap goc T0 tren camera):
#     1. Dua T0 den tren camera (Z=40).
#     2. Chay lenh: KTAMV_CALIBRATE_T0
#   Giai doan B (Tu dong do toan bo T1 den T4):
#     1. Chay lenh: KTAMV_AUTO_CALIBRATE_ALL_TOOLS SAMPLES=3
#   Giai doan C (Luu):
#     1. Chay lenh: SAVE_CONFIG
#
# CACH 3: DO RIENG LE TUNG TOOL (KHI CAN TEST HOAC CHINH LAI 1 TOOL)
# ---------------------------------------------------------------------
#   (Yeu cau: Da tung chay KTAMV_CALIBRATE_T0 trong phien lam viec)
#   1. Chon tool can do (vi du T1):
#        T1
#   2. Do lap lai 3 lan:
#        KTAMV_MEASURE_TOOL_XY SAMPLES=3 Z=40
#   3. Nap sai so vua do vao tool:
#        _KTAMV_APPLY_ACTIVE_TOOL_XY
#   4. Luu vinh vien:
#        SAVE_CONFIG
# =====================================================================

[ktamv]
nozzle_cam_url: http://127.0.0.1/webcam/?action=snapshot
server_url: http://127.0.0.1:8086
move_speed: 1800
calib_iterations: 1
calib_value: 1.0
send_frame_to_cloud: false
detection_tolerance: 0
measurement_z: 40
measurement_samples: 3
measurement_max_spread: 0.12

# Tu dong dong bo URL camera sang kTAMV server sau khi Klipper khoi dong 3 giay (chong loi 502)
[delayed_gcode _KTAMV_AUTO_INIT]
initial_duration: 3.0
gcode:
  KTAMV_SEND_SERVER_CFG

# ---------------------------------------------------------------------
# 1. CAC LENH CO BAN & TRANG THAI (KHONG DI CHUYEN MAY)
# ---------------------------------------------------------------------

[gcode_macro _KTAMV_SETUP]
description: Helper noi bo: Gui thong so cau hinh camera nozzle toi kTAMV server
gcode:
  KTAMV_SEND_SERVER_CFG

[gcode_macro KTAMV_STATUS]
description: Bao cao trang thai camera calibration, mm/pixel va toa do origin (khong di chuyen)
gcode:
  {% if printer.ktamv is defined %}
    RESPOND MSG="kTAMV active: calibrated={printer.ktamv.is_calibrated}, mm_per_pixel={printer.ktamv.mm_per_pixels}, origin={printer.ktamv.camera_center_coordinates}"
    RESPOND MSG="Server port: 8086 | Cloud upload: disabled | Truc: XY only"
    {% if printer.ktamv.last_offset_average is not none %}
      RESPOND MSG="Ket qua do XY gan nhat: Tool={printer.ktamv.last_measured_tool_number}, Samples={printer.ktamv.last_offset_samples}, Mean={printer.ktamv.last_offset_average}, Spread={printer.ktamv.last_offset_spread}"
    {% endif %}
  {% else %}
    RESPOND TYPE=error MSG="kTAMV module chua duoc nap"
  {% endif %}

# ---------------------------------------------------------------------
# 2. MACRO CALIB GOC T0 VA CAMERA (1-CHAM CHO GIAI DOAN CHUAN BI)
# ---------------------------------------------------------------------

[gcode_macro KTAMV_CALIBRATE_T0]
description: Calib camera mm/pixel, tu dong tim tam T0 va luu toa do goc quy chieu (Origin)
gcode:
  {% set safe_z = params.Z|default(40)|float %}
  {% if "xyz" not in printer.toolhead.homed_axes %}
    {action_raise_error("May in chua duoc Home! Hay chay G28 truoc.")}
  {% elif printer.toolchanger.status != "ready" %}
    {action_raise_error("Toolchanger chua o trang thai ready")}
  {% elif printer.toolchanger.tool_number|int != 0 %}
    {action_raise_error("Vui long chon Tool 0 (T0) truoc khi calib goc")}
  {% else %}
    RESPOND MSG="=== [KTAMV] BAT DAU CALIB CAMERA VA XAC LAP GOC T0 ==="
    # 1. Dong bo camera URL sang server de phong ngua
    KTAMV_SEND_SERVER_CFG
    # 2. Tat LED T0 tranh choi loa camera
    SET_LED LED=T0_LED RED=0 GREEN=0 BLUE=0 TRANSMIT=1
    # 3. Do ti le mm/pixel
    RESPOND MSG=">>> Dang do ti le mm/pixel..."
    KTAMV_CALIB_CAMERA
    # 4. Tu dong can chinh tam nozzle T0
    RESPOND MSG=">>> Dang can tam nozzle T0..."
    KTAMV_FIND_NOZZLE_CENTER
    # 5. Luu vi tri tam lam goc quy chieu Origin
    KTAMV_SET_ORIGIN
    # 6. Bao cao trang thai hoan tat
    KTAMV_STATUS
    RESPOND MSG="=== [KTAMV] HOAN TAT CALIB T0! San sang do cac tool tiep theo. ==="
  {% endif %}

# ---------------------------------------------------------------------
# 3. DO VA NAP OFFSET CHO TUNG TOOL DANG CHON (HELPER NOI BO)
# ---------------------------------------------------------------------

[gcode_macro _KTAMV_MEASURE_ACTIVE_TOOL_XY]
description: Helper noi bo: Can tam tool dang active lap lai 3 lan va bao cao sai so trung binh XY
gcode:
  {% set samples = params.SAMPLES|default(3)|int %}
  {% set max_spread = params.MAX_SPREAD|default(0.12)|float %}
  {% set safe_z = params.Z|default(40)|float %}
  {% if not printer.ktamv.is_calibrated %}
    {action_raise_error("Camera chua duoc calib! Hay can tam T0 va chay KTAMV_CALIBRATE_T0 truoc")}
  {% elif printer.ktamv.camera_center_coordinates is none %}
    {action_raise_error("Chua set goc toa do! Can tam T0 va chay KTAMV_CALIBRATE_T0 truoc")}
  {% elif printer.toolchanger.status != "ready" %}
    {action_raise_error("Toolchanger chua o trang thai ready")}
  {% elif printer.toolchanger.tool_number is none %}
    {action_raise_error("Chua co tool nao duoc kich hoat")}
  {% elif printer.toolchanger.detected_tool_number|int != printer.toolchanger.tool_number|int %}
    {action_raise_error("Tool vat ly tren dau in khong khop voi tool dang kich hoat")}
  {% else %}
    {% set tool_number = printer.toolchanger.tool_number|int %}
    SET_LED LED=T{tool_number}_LED RED=0 GREEN=0 BLUE=0 TRANSMIT=1
    KTAMV_MEASURE_TOOL_XY SAMPLES={samples} Z={safe_z} MAX_SPREAD={max_spread}
  {% endif %}

[gcode_macro _KTAMV_APPLY_ACTIVE_TOOL_XY]
description: Helper noi bo: Nap gia tri sai so XY trung binh vua do vao tool dang active (tru T0)
gcode:
  {% set tool_number = printer.toolchanger.tool_number|int %}
  {% set result = printer.ktamv.last_offset_average %}
  {% set spread = printer.ktamv.last_offset_spread %}
  {% if printer.toolchanger.status != "ready" %}
    {action_raise_error("Toolchanger chua o trang thai ready")}
  {% elif printer.toolchanger.detected_tool_number|int != tool_number %}
    {action_raise_error("Tool vat ly khong khop voi active tool")}
  {% elif tool_number == 0 %}
    {action_raise_error("T0 la goc quy chieu, luon phai giu XY offset = 0")}
  {% elif result is none or spread is none %}
    {action_raise_error("Chua co ket qua do kTAMV nao hop le")}
  {% elif printer.ktamv.last_measured_tool_number|int != tool_number %}
    {action_raise_error("Ket qua do gan nhat thuoc ve tool khac, khong the ap dung")}
  {% elif spread[0]|float > 0.12 or spread[1]|float > 0.12 %}
    {action_raise_error("Do phan tan spread vuot qua nguong an toan 0.12 mm")}
  {% else %}
    {% set tool = printer[printer.toolchanger.tool] %}
    {% set new_x = ((tool.gcode_x_offset|float) + (result[0]|float))|round(3) %}
    {% set new_y = ((tool.gcode_y_offset|float) + (result[1]|float))|round(3) %}
    SET_TOOL_PARAMETER T={tool_number} PARAMETER=gcode_x_offset VALUE={new_x}
    SET_TOOL_PARAMETER T={tool_number} PARAMETER=gcode_y_offset VALUE={new_y}
    SAVE_TOOL_PARAMETER T={tool_number} PARAMETER=gcode_x_offset
    SAVE_TOOL_PARAMETER T={tool_number} PARAMETER=gcode_y_offset
    RESPOND MSG="Da cap nhat offset T{tool_number}: X={new_x} Y={new_y} (Residual: X={result[0]} Y={result[1]})"
    RESPOND MSG="Chu y: Chay SAVE_CONFIG de luu vinh vien vao printer.cfg sau khi hoan tat tat ca tool"
  {% endif %}

# ---------------------------------------------------------------------
# 4. QUY TRINH DO TU DONG TUAN TU (AUTOMATED MULTI-TOOL WORKFLOW)
# ---------------------------------------------------------------------

[gcode_macro _KTAMV_CALIBRATE_TOOL]
description: Helper noi bo: chuyen tool, tiep can toa do camera da hoc (origin), do va nap offset
gcode:
  {% set tool = params.T|int %}
  {% set samples = params.SAMPLES|default(3)|int %}
  {% set max_spread = params.MAX_SPREAD|default(0.12)|float %}
  {% set safe_z = params.Z|default(40)|float %}
  {% set origin = printer.ktamv.camera_center_coordinates %}

  RESPOND MSG=">>> [KTAMV] Chuyen sang T{tool} va tiep can toa do camera da hoc <<<"
  T{tool}
  # Nang Z len do cao an toan ngay tai vi tri sau pickup dock
  G90
  G1 Z{safe_z} F1800
  # Di chuyen toi toa do tam camera da hoc boi T0 (learned origin)
  G1 X{origin[0]} Y{origin[1]} F3000
  SET_LED LED=T{tool}_LED RED=0 GREEN=0 BLUE=0 TRANSMIT=1
  _KTAMV_MEASURE_ACTIVE_TOOL_XY SAMPLES={samples} MAX_SPREAD={max_spread} Z={safe_z}
  _KTAMV_APPLY_ACTIVE_TOOL_XY

[gcode_macro KTAMV_AUTO_CALIBRATE_ALL_TOOLS]
description: Quy trinh tu dong do va cap nhat offset XY cho tat ca tool T1->T4 dua tren toa do camera da hoc tu T0
gcode:
  {% set samples = params.SAMPLES|default(3)|int %}
  {% set max_spread = params.MAX_SPREAD|default(0.12)|float %}
  {% set safe_z = params.Z|default(40)|float %}

  {% if "xyz" not in printer.toolhead.homed_axes %}
    {action_raise_error("May in chua duoc Home! Hay chay G28 truoc.")}
  {% elif not printer.ktamv.is_calibrated %}
    {action_raise_error("Camera chua duoc calib! Hay can tam T0 va chay KTAMV_CALIBRATE_T0 truoc.")}
  {% elif printer.ktamv.camera_center_coordinates is none %}
    {action_raise_error("Chua co toa do goc T0! Hay can tam T0 va chay KTAMV_CALIBRATE_T0 truoc.")}
  {% else %}
    _KTAMV_SETUP
    {% set origin = printer.ktamv.camera_center_coordinates %}
    RESPOND MSG="=========================================================="
    RESPOND MSG="BAT DAU QUY TRINH DO XY TU DONG kTAMV (T1 -> T4)"
    RESPOND MSG="Toa do camera da hoc (Learned Origin): X={origin[0]} Y={origin[1]} | Safe Z={safe_z}"
    RESPOND MSG="=========================================================="

    _KTAMV_CALIBRATE_TOOL T=1 SAMPLES={samples} MAX_SPREAD={max_spread} Z={safe_z}
    _KTAMV_CALIBRATE_TOOL T=2 SAMPLES={samples} MAX_SPREAD={max_spread} Z={safe_z}
    _KTAMV_CALIBRATE_TOOL T=3 SAMPLES={samples} MAX_SPREAD={max_spread} Z={safe_z}
    _KTAMV_CALIBRATE_TOOL T=4 SAMPLES={samples} MAX_SPREAD={max_spread} Z={safe_z}

    # Ket thuc: chuyen ve T0 va giu vi tri tai tam camera da hoc o Z an toan
    RESPOND MSG=">>> Do xong T1-T4, quay ve T0 va giu vi tri an toan <<<"
    T0
    G90
    G1 Z{safe_z} F1800
    G1 X{origin[0]} Y{origin[1]} F3000

    RESPOND MSG="=========================================================="
    RESPOND MSG="HOAN TAT DO TU DONG kTAMV CHO TOAN BO 5 TOOL!"
    RESPOND MSG="Kiem tra lai toan bo offset bang lenh: CHECK_OFFSETS"
    RESPOND MSG="Chay lenh SAVE_CONFIG de luu vinh vien vao printer.cfg"
    RESPOND MSG="=========================================================="
  {% endif %}

# ---------------------------------------------------------------------
# 5. MACRO 1-CHAM TOAN TRINH (TU A DEN Z)
# ---------------------------------------------------------------------

[gcode_macro KTAMV_FULL_CALIBRATION_CYCLE]
description: Quy trinh 1-cham: Calib T0, hoc goc camera va tu dong do toan bo T1->T4 (Yeu cau T0 da o tren camera)
gcode:
  {% set samples = params.SAMPLES|default(3)|int %}
  {% set safe_z = params.Z|default(40)|float %}
  {% set max_spread = params.MAX_SPREAD|default(0.12)|float %}

  {% if "xyz" not in printer.toolhead.homed_axes %}
    {action_raise_error("May in chua duoc Home! Hay chay G28 truoc.")}
  {% elif printer.toolchanger.tool_number|int != 0 %}
    {action_raise_error("Vui long chon T0 va dua T0 len tren mat kinh camera truoc khi chay macro nay.")}
  {% else %}
    RESPOND MSG=">>> [KTAMV FULL CYCLE] BUOC 1: XAC LAP GOC TOA DO T0 <<<"
    KTAMV_CALIBRATE_T0 Z={safe_z}
    RESPOND MSG=">>> [KTAMV FULL CYCLE] BUOC 2: TU DONG DO VA NAP OFFSET T1 -> T4 <<<"
    KTAMV_AUTO_CALIBRATE_ALL_TOOLS SAMPLES={samples} MAX_SPREAD={max_spread} Z={safe_z}
    RESPOND MSG=">>> [KTAMV FULL CYCLE] HOAN TAT! Vui long chay SAVE_CONFIG de luu vao file. <<<"
  {% endif %}
