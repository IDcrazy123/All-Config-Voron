# =====================================================================
# kTAMV - Klipper Tool Alignment with Machine Vision (Voron 5-Tool)
# Upstream: https://github.com/TypQxQ/kTAMV
# Reviewed commit: 72421f2d54da0de8701c4f84449c6e6b7d060301
# =====================================================================
#
# QUY TRINH DO SAI LECH XY TUNG BUOC (KEM TAT LED CHONG HAT SANG):
# ---------------------------------------------------------------------
#   NGUYEN LY QUAN TRONG:
#     Khi can tam quang hoc, 2 bong LED nozzle tren dau in va den buong in
#     chieu truc tiep vao kim loai va mat kinh camera se gay choi loa trang,
#     khien thuat toan OpenCV khong the nhan dien duoc lo tron nozzle.
#     -> Luon phai TAT DEN LED truoc khi thuc hien cac phep do quang hoc!
#
#   BUOC 1: KHOI DONG & CANH VÒI PHUN T0 VAO CAMERA
#     1. Dat ga camera len ban in tai vi tri thuan tien.
#     2. Home may in (G28), chon Tool 0 (T0).
#     3. Dung giao dien Mainsail Jog dua dau phun T0 den tren mat kinh camera
#        o do cao Z = 35 mm sao cho nhin thay lo nozzle trong khung hinh (:8086/image).
#
#   BUOC 2: CALIB CAMERA & KHOA GOC THAM CHIEU T0 (ORIGIN)
#     Chay lan luot cac lenh:
#     1. KTAMV_SEND_SERVER_CFG    ; Ket noi & dong bo cau hinh voi server
#     2. KTAMV_LEDS_OFF           ; [QUAN TRONG] Tat den dau in va buong in de chong hat sang
#     3. KTAMV_CALIB_CAMERA       ; Do ti le mm/pixel (may nhich nho quanh nozzle)
#     4. KTAMV_FIND_AND_CENTER    ; Can tam nozzle T0 vao giua khung hinh camera
#     5. KTAMV_SET_ORIGIN         ; Khoa toa do tam T0 lam goc tham chieu XY (X=0, Y=0)
#
#   BUOC 3: DO VA NAP OFFSET CHO TUNG TOOL (T1 -> T4)
#     Voi moi tool (vi du T1):
#     1. Chuyen tool: T1          ; Khi doi tool, den led se tu sang len
#     2. KTAMV_MOVE_TO_ORIGIN     ; Bay den camera o Z=35 va TU DONG TAT DEN LED chong hat sang!
#     3. KTAMV_FIND_AND_CENTER    ; Can tam nozzle T1 vao giua camera
#     4. KTAMV_GET_OFFSET         ; Tinh do lech XY cua T1 so voi T0
#     5. KTAMV_APPLY_TOOL_OFFSET TOOL=1  ; Nap offset vao T1
#     (Lap lai quy trinh 5 buoc tren cho T2, T3, T4)
#
#   BUOC 4: HOAN TAT, BAT LAI DEN & LUU VINH VIEN
#     1. Chuyen ve T0: T0
#     2. KTAMV_LEDS_RESTORE       ; Bat lai den LED binh thuong
#     3. CHECK_OFFSETS            ; Kiem tra bang tong hop offset
#     4. SAVE_CONFIG              ; Luu vao printer.cfg va khoi dong lai
# =====================================================================

[ktamv]
nozzle_cam_url: http://127.0.0.1/webcam/?action=snapshot
server_url: http://127.0.0.1:8086
move_speed: 1800
calib_iterations: 1
calib_value: 1.0
send_frame_to_cloud: false
detection_tolerance: 0
measurement_z: 35
measurement_samples: 3
measurement_max_spread: 0.12

# Tu dong dong bo URL camera sang kTAMV server sau khi Klipper khoi dong 3 giay (chong loi 502)
[delayed_gcode _KTAMV_AUTO_INIT]
initial_duration: 3.0
gcode:
  KTAMV_SEND_SERVER_CFG

# ---------------------------------------------------------------------
# 1. QUAN LY ANH SANG & LED CHUYEN DUNG (CHONG CHOI LOA NOZZLE)
# ---------------------------------------------------------------------

[gcode_macro KTAMV_LEDS_OFF]
description: Tat toan bo LED dau in (tranh 2 led nozzle chieu vao camera gay loi nhan dien) va den buong in
gcode:
  {% for tn in printer.toolchanger.tool_numbers %}
    {% set led = "T" ~ tn|string ~ "_LED" %}
    {% if printer["neopixel " ~ led] is defined %}
      SET_LED LED={led} RED=0 GREEN=0 BLUE=0 TRANSMIT=1
    {% endif %}
  {% endfor %}
  {% if "neopixel chamber_lights" in printer.configfile.config %}
    SET_LED LED=chamber_lights RED=0 GREEN=0 BLUE=0 TRANSMIT=1
  {% endif %}
  RESPOND MSG="Da tat toan bo LED dau in & buong in de chong hat sang camera."

[gcode_macro KTAMV_LEDS_RESTORE]
description: Khoi phuc trang thai LED dau in va he thong sau khi hoan tat calib
gcode:
  {% set active = printer.toolchanger.tool_number|default(-1)|int %}
  {% if active >= 0 %}
    _SET_TOOL_LED T={active} STATE=ready
  {% endif %}
  _SYNC_INACTIVE_LEDS
  RESPOND MSG="Da khoi phuc trang thai LED he thong."

# Alias noi bo giu tuong thich nguoc
[gcode_macro _KTAMV_LEDS_OFF]
gcode:
  KTAMV_LEDS_OFF

[gcode_macro _KTAMV_LEDS_RESTORE]
gcode:
  KTAMV_LEDS_RESTORE

# ---------------------------------------------------------------------
# 2. CAC MACRO DIEU KHIEN CHUAN kTAMV (MODULAR)
# ---------------------------------------------------------------------

[gcode_macro KTAMV_MOVE_TO_ORIGIN]
description: Di chuyen tool hien tai toi toa do Origin camera da hoc o do cao Z an toan (35mm) va tu dong tat den LED chong hat sang
gcode:
  {% set safe_z = params.Z|default(printer.ktamv.measurement_z|default(35))|float %}
  {% if "xyz" not in printer.toolhead.homed_axes %}
    {action_raise_error("May in chua duoc Home! Hay chay G28 truoc.")}
  {% elif printer.ktamv.camera_center_coordinates is none %}
    {action_raise_error("Chua co toa do Origin camera! Hay chay KTAMV_SET_ORIGIN voi T0 truoc.")}
  {% else %}
    {% set origin = printer.ktamv.camera_center_coordinates %}
    RESPOND MSG="Di chuyen toi camera Origin: X={origin[0]} Y={origin[1]} o Z={safe_z}..."
    G90
    G1 Z{safe_z} F1800
    G1 X{origin[0]} Y{origin[1]} F3000
    # Tu dong tat LED dau in de chong loa ngay sau khi bay den camera
    KTAMV_LEDS_OFF
  {% endif %}

[gcode_macro KTAMV_CALIB_CAMERA_SAFE]
description: Tat LED chong loa va thuc hien calib ti le mm/pixel (KTAMV_CALIB_CAMERA)
gcode:
  KTAMV_LEDS_OFF
  G4 P200
  KTAMV_CALIB_CAMERA

[gcode_macro KTAMV_FIND_AND_CENTER]
description: Dam bao tat LED chong loa, tim tam nozzle va di chuyen nozzle ve dung giua khung hinh camera
gcode:
  {% if "xyz" not in printer.toolhead.homed_axes %}
    {action_raise_error("May in chua duoc Home! Hay chay G28 truoc.")}
  {% else %}
    KTAMV_LEDS_OFF
    G4 P200
    KTAMV_FIND_NOZZLE_CENTER
  {% endif %}

[gcode_macro KTAMV_APPLY_TOOL_OFFSET]
description: Ap dung ket qua sai lech XY vua do vao tool chi dinh (mac dinh la tool dang active)
gcode:
  {% set tool_number = params.TOOL|default(printer.toolchanger.tool_number)|int %}
  {% set result = printer.ktamv.last_offset_average %}
  {% if result is none %}
    {% set result = printer.ktamv.last_calculated_offset %}
  {% endif %}

  {% if tool_number == 0 %}
    {action_raise_error("T0 la goc quy chieu, luon phai giu XY offset = 0")}
  {% elif result is none %}
    {action_raise_error("Chua co ket qua do kTAMV nao hop le! Hay chay KTAMV_GET_OFFSET truoc.")}
  {% else %}
    {% set tool_name = "tool T" ~ tool_number|string %}
    {% set tool = printer[tool_name] %}
    {% set new_x = ((tool.gcode_x_offset|float) + (result[0]|float))|round(3) %}
    {% set new_y = ((tool.gcode_y_offset|float) + (result[1]|float))|round(3) %}
    SET_TOOL_PARAMETER T={tool_number} PARAMETER=gcode_x_offset VALUE={new_x}
    SET_TOOL_PARAMETER T={tool_number} PARAMETER=gcode_y_offset VALUE={new_y}
    SAVE_TOOL_PARAMETER T={tool_number} PARAMETER=gcode_x_offset
    SAVE_TOOL_PARAMETER T={tool_number} PARAMETER=gcode_y_offset
    RESPOND MSG="Da cap nhat offset T{tool_number}: X={new_x} Y={new_y} (Do lech: X={result[0]} Y={result[1]})"
    RESPOND MSG="Chay SAVE_CONFIG de luu vinh vien vao printer.cfg sau khi do het cac tool"
  {% endif %}

[gcode_macro KTAMV_STATUS]
description: Bao cao trang thai camera calibration, mm/pixel va toa do origin
gcode:
  {% if printer.ktamv is defined %}
    RESPOND MSG="kTAMV active: calibrated={printer.ktamv.is_calibrated}, mm_per_pixel={printer.ktamv.mm_per_pixels}, origin={printer.ktamv.camera_center_coordinates}"
    RESPOND MSG="Server: {printer.ktamv.server_url} | Safe Z: {printer.ktamv.measurement_z}"
    {% if printer.ktamv.last_calculated_offset is not none %}
      RESPOND MSG="Offset tinh gan nhat: X={printer.ktamv.last_calculated_offset[0]} Y={printer.ktamv.last_calculated_offset[1]}"
    {% endif %}
  {% else %}
    RESPOND TYPE=error MSG="kTAMV module chua duoc nap"
  {% endif %}
